<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharpInference.Core\SharpInference.Core.csproj" />
    <ProjectReference Include="..\SharpInference.Vm.Optimization\SharpInference.Vm.Optimization.csproj" />
    <ProjectReference Include="..\SharpInference.Backends.CpuVm\SharpInference.Backends.CpuVm.csproj" />
    <ProjectReference Include="..\SharpInference.Instructions.Cpu\SharpInference.Instructions.Cpu.csproj" />
    <Compile Include="$(VmArtifactDirectory)\*.cs" Link="Generated\%(Filename)%(Extension)" Condition="'$(VmArtifactDirectory)' != ''" />
    <EmbeddedResource Include="$(VmArtifactDirectory)\*" LogicalName="VmPackage.%(Filename)%(Extension)" Condition="'$(VmArtifactDirectory)' != ''" />
  </ItemGroup>
  <Target Name="ValidateVmArtifact" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(VmArtifactDirectory)' == ''" Text="Set VmArtifactDirectory to a source-only CPU VM artifact package." />
    <Error Condition="!Exists('$(VmArtifactDirectory)')" Text="VmArtifactDirectory does not exist." />
  </Target>
</Project>
