{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Information"
    }
  },
  "AllowedHosts": "*",
  "Server": {
    "Urls": "http://0.0.0.0:9841"
  },
  "Rwkv": {
    "DefaultMaxTokens": 4096,
    "ContextWindowTokens": 12800,
    "ApiKey": "",
    "GpuBatchService": {
      "MaxResidentGpuSessions": 64
    },
    "StateManager": {
      "Capacity": 10
    },
    "Runtime": {
      "Kind": "vortice",
      "Vortice": {
        "AdapterIndex": 0
      },
      "Vm": {
        "PrefillInstances": 2,
        "InferenceInstances": 2,
        "PrefillQueueCapacity": 16,
        "InferenceQueueCapacity": 16,
        "PrefillCapacity": 64
      }
    }
  }
}
