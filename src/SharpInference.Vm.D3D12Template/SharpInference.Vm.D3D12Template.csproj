<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);GPU_VM</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharpInference.Core\SharpInference.Core.csproj" />
    <ProjectReference Include="..\SharpInference.Backends.D3D12Vm\SharpInference.Backends.D3D12Vm.csproj" />
    <ProjectReference Include="..\SharpInference.Vm.Optimization\SharpInference.Vm.Optimization.csproj" />
    <ProjectReference Include="..\SharpInference.Models.Rwkv\SharpInference.Models.Rwkv.csproj" />
    <Compile Include="..\SharpInference.Vm.Template\Program.cs" Link="Program.cs" />
    <EmbeddedResource Include="$(VmArtifactDirectory)\program.vm.zip" LogicalName="VmPackage.program.vm.zip" Condition="'$(VmArtifactDirectory)' != ''" />
  </ItemGroup>
  <Target Name="ValidateVmArtifact" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(VmArtifactDirectory)' == ''" Text="Set VmArtifactDirectory to a compiled DXIL VM artifact directory." />
    <Error Condition="!Exists('$(VmArtifactDirectory)\program.vm.zip')" Text="The DXIL VM artifact package is missing." />
  </Target>
</Project>
