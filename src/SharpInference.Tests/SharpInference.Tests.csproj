    <ProjectReference Include="..\SharpInference.Backends.Vortice\SharpInference.Backends.Vortice.csproj" />
    <ProjectReference Include="..\SharpInference.WebApi\SharpInference.WebApi.csproj" />
    <ProjectReference Include="..\SharpInference.Graphs\SharpInference.Graphs.csproj" />
