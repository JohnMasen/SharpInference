<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SharpInferenceSourceRoot Condition="'$(SharpInferenceSourceRoot)' == ''">$(MSBuildThisFileDirectory)..\..</SharpInferenceSourceRoot>
    <TierOneApi Condition="'$(TierOneApi)' == ''">true</TierOneApi>
    <DefineConstants Condition="'$(TierOneApi)' == 'true'">$(DefineConstants);TIER_ONE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(SharpInferenceSourceRoot)\src\SharpInference.Architectures.Phi4\SharpInference.Architectures.Phi4.csproj" />
    <ProjectReference Include="$(SharpInferenceSourceRoot)\src\SharpInference.Architectures.Phi4.D3D12\SharpInference.Architectures.Phi4.D3D12.csproj" />
    <ProjectReference Include="$(SharpInferenceSourceRoot)\src\SharpInference.Runtime\SharpInference.Runtime.csproj" />
  </ItemGroup>
</Project>
